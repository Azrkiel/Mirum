# Mirum environment configuration.
#
#   cp .env.example .env    then fill in the real values.
#
# .env is gitignored and must NEVER be committed. On the deployment server
# it lives beside docker-compose.yml and survives `git reset --hard`
# (gitignored files are untouched), so the deploy workflow cannot clobber it.

# ---------------------------------------------------------------------------
# Gemini API keys
# ---------------------------------------------------------------------------

# REQUIRED. Used by Machinist, Critic, Refiner, classifier, and the Lite tier.
GEMINI_API_KEY_HEAVY=

# Optional. Planner + REA (Pro tier). Falls back to the Heavy key when unset —
# set this only if your Pro quota sits on a separate key.
GEMINI_API_KEY_PRO=

# ---------------------------------------------------------------------------
# Endpoint authentication  (REQUIRED for any networked deployment)
# ---------------------------------------------------------------------------

# Shared secret between the Streamlit frontend and the FastAPI backend, sent
# as the X-API-Key header. When unset the backend skips the check entirely,
# which is convenient locally but unacceptable on a reachable host: every
# generation endpoint runs LLM-authored code and spends Gemini quota.
#
# Generate:  openssl rand -hex 32
MIRUM_API_KEY=

# Guards POST /admin/model-config. Unset = admin API disabled (503).
# Generate:  openssl rand -hex 32
ADMIN_API_KEY=

# /run executes an arbitrary caller-supplied CadQuery script in the sandbox.
# It is what the UI's "Run" and "Apply Parameters" buttons call.
#
# Tri-state — REMOVING this line does not mean "off":
#   1 / true / yes  -> always enabled
#   0 / false / no  -> always disabled
#   unset/blank     -> enabled IF MIRUM_API_KEY is set, disabled if not
#
# The unset default follows the threat model: with an API key the backend is
# authenticated and loopback-only, and the same sandbox already executes
# LLM-authored code on every /generate. Note it does raise the value of a
# leaked MIRUM_API_KEY — it turns "attacker can spend your Gemini quota" into
# "attacker has direct, deterministic sandbox execution". Pin it to 0 if that
# trade is not one you want.
MIRUM_ENABLE_RUN_ENDPOINT=0

# ---------------------------------------------------------------------------
# Public entry point (Caddy reverse proxy)
# ---------------------------------------------------------------------------

# ":80" serves plain HTTP on any hostname or bare IP — correct for an OCI
# instance with no domain. Set a real hostname (mirum.example.com) and Caddy
# provisions a Let's Encrypt certificate automatically; that requires the
# domain's DNS to point here and ports 80/443 to be open.
MIRUM_SITE_ADDRESS=:80

# HTTP basic-auth credentials for the public UI.
# Generate the hash (never store the plaintext):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# The result starts with $2a$ — wrap it in single quotes so the shell and
# Compose do not try to interpolate the $ signs.
MIRUM_BASIC_AUTH_USER=mirum
MIRUM_BASIC_AUTH_HASH=

# Let's Encrypt contact address. Only used when MIRUM_SITE_ADDRESS is a domain.
MIRUM_ACME_EMAIL=

# ---------------------------------------------------------------------------
# Pipeline tuning (all optional — defaults shown)
# ---------------------------------------------------------------------------

# Machinist attempts per part before the critic loop gives up.
MIRUM_CRITIC_MAX_RETRIES=3

# CadQuery subprocess timeout in seconds. Clamped to [5, 60] in code.
MIRUM_CADQUERY_TIMEOUT_S=30

# Relative tolerance for the dimension-vs-spec gate (0.05 = 5%).
MIRUM_DIM_TOL=0.05

# Run the LVM code-judge in production. Off by default: it costs one Gemini
# call per successful part and nothing reads the score at runtime.
MIRUM_LVM_IN_PROD=0

# Where telemetry (and therefore the few-shot retrieval corpus) is stored.
# docker-compose already mounts a named volume at the default path below, so
# the corpus now survives restarts without any action here. Override only if
# you want it somewhere else; a path under /tmp puts it back on the tmpfs and
# the index will be wiped on every restart.
# MIRUM_TELEMETRY_DIR=/var/lib/mirum/telemetry
