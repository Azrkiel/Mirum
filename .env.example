# Mirum environment configuration (model-related entries).
#
#   cp .env.example .env    then fill in the real values.
#
# .env is gitignored and must NEVER be committed.

# REQUIRED. Used by Machinist, Critic, Refiner, classifier, and the Lite tier.
GEMINI_API_KEY_HEAVY=

# Optional. Planner + REA (Pro tier). Falls back to the Heavy key when unset -
# set this only if your Pro quota sits on a separate key.
GEMINI_API_KEY_PRO=

# Per-agent model ids and sampling temperatures live in the ModelRegistry
# (backend/subagents/model_registry.py) and are hot-swappable at runtime via
# POST /admin/model-config (guarded by ADMIN_API_KEY; unset = admin API off).
# The Machinist escalates to the Pro-tier "critic" config on its final retry.
# Generate:  openssl rand -hex 32
ADMIN_API_KEY=

# Pipeline tuning (all optional - defaults shown).
# Machinist attempts per part before the critic loop gives up.
MIRUM_CRITIC_MAX_RETRIES=3
# CadQuery subprocess timeout in seconds. Clamped to [5, 60] in code.
MIRUM_CADQUERY_TIMEOUT_S=30
# Relative tolerance for the dimension-vs-spec check (0.05 = 5%).
MIRUM_DIM_TOL=0.05

# Download artifacts (STEP/GLB). Must stay under /tmp/mirum (read-only rootfs)
# and separate from MIRUM_WORK_DIR (the sandbox cwd). All optional.
# MIRUM_ARTIFACT_DIR=/tmp/mirum/artifacts
# MIRUM_ARTIFACT_TTL_S=21600
# MIRUM_ARTIFACT_MAX_RUNS=50
# MIRUM_ARTIFACT_MAX_TOTAL_BYTES=536870912
# MIRUM_ARTIFACT_MAX_BYTES=67108864
