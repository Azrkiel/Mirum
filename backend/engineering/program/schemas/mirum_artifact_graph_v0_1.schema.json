{
  "$defs": {
    "ArtifactNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "solid",
            "face",
            "edge"
          ],
          "title": "Kind",
          "type": "string"
        },
        "op_seq": {
          "minimum": 0,
          "title": "Op Seq",
          "type": "integer"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "op_seq"
      ],
      "title": "ArtifactNode",
      "type": "object"
    },
    "OpStream": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/OpStreamEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "schema_version": {
          "const": "mirum_op_stream_v0_1",
          "enum": [
            "mirum_op_stream_v0_1"
          ],
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "entries"
      ],
      "title": "OpStream",
      "type": "object"
    },
    "OpStreamEntry": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "operation_version": {
          "title": "Operation Version",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "step_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Ref"
        }
      },
      "required": [
        "seq",
        "operation",
        "operation_version"
      ],
      "title": "OpStreamEntry",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "1-based, end inclusive.",
      "properties": {
        "column": {
          "title": "Column",
          "type": "integer"
        },
        "end_column": {
          "title": "End Column",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "line",
        "column",
        "end_line",
        "end_column"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/ArtifactNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "op_stream": {
      "$ref": "#/$defs/OpStream"
    },
    "schema_version": {
      "const": "mirum_artifact_graph_v0_1",
      "enum": [
        "mirum_artifact_graph_v0_1"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "op_stream",
    "nodes"
  ],
  "title": "ArtifactGraph",
  "type": "object"
}
