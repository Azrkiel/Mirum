{
  "$defs": {
    "AttemptSummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckSummary"
          },
          "maxItems": 64,
          "title": "Checks",
          "type": "array"
        },
        "failure_count": {
          "maximum": 9007199254740992,
          "minimum": 0,
          "title": "Failure Count",
          "type": "integer"
        },
        "ordinal": {
          "exclusiveMaximum": 4,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "outcome": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "ordinal",
        "candidate_sha256",
        "outcome",
        "failure_count",
        "checks"
      ],
      "title": "AttemptSummary",
      "type": "object"
    },
    "BundleDigests": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "payloads": {
          "items": {
            "$ref": "#/$defs/PayloadDigest"
          },
          "maxItems": 64,
          "title": "Payloads",
          "type": "array"
        },
        "zip_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Zip Sha256",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256",
        "zip_sha256",
        "payloads"
      ],
      "title": "BundleDigests",
      "type": "object"
    },
    "CheckSummary": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "state": {
          "maxLength": 64,
          "minLength": 1,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "state"
      ],
      "title": "CheckSummary",
      "type": "object"
    },
    "EvidenceCheck": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 32,
          "title": "Category",
          "type": "string"
        },
        "check_id": {
          "maxLength": 240,
          "title": "Check Id",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "measured",
            "policy_report",
            "identity_only",
            "not_evaluated"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z_]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "not_evaluated",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "category",
        "required",
        "state",
        "coverage"
      ],
      "title": "EvidenceCheck",
      "type": "object"
    },
    "EvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/AttemptSummary"
          },
          "maxItems": 4,
          "title": "Attempts",
          "type": "array"
        },
        "bundle": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleDigests"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expired": {
          "default": false,
          "title": "Expired",
          "type": "boolean"
        },
        "lifecycle": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Lifecycle",
          "type": "string"
        },
        "outcome": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "selected_candidate_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Candidate Sha256"
        }
      },
      "required": [
        "lifecycle",
        "outcome",
        "attempts"
      ],
      "title": "EvidenceSummary",
      "type": "object"
    },
    "PayloadDigest": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "PayloadDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Sha256"
    },
    "check_plan_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Check Plan Sha256"
    },
    "checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceCheck"
      },
      "maxItems": 32,
      "title": "Checks",
      "type": "array"
    },
    "claim_scope": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Scope"
    },
    "glb_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Glb Sha256"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Sha256"
    },
    "method_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method Version"
    },
    "reasons": {
      "default": [],
      "items": {
        "maxLength": 64,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Reasons",
      "type": "array"
    },
    "run": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "present",
        "none"
      ],
      "title": "Status",
      "type": "string"
    },
    "step_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step Sha256"
    },
    "verdict": {
      "anyOf": [
        {
          "enum": [
            "verified",
            "failed",
            "ambiguous",
            "unavailable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict"
    }
  },
  "required": [
    "status"
  ],
  "title": "EvidenceView",
  "type": "object"
}
