# PicoGK native runtime for linux-x64. Derived from upstream Misc/Dockerfile.
# Build context: this directory. Optional extra CA (TLS-intercepting proxy), never required:
#   docker build --secret id=extra_ca,src=avast-ca.pem ...
# The CA is only mounted for the RUN steps that use the network. It is combined with the
# system bundle in /tmp, used via SSL_CERT_FILE/GIT_SSL_CAINFO/apt CaInfo, and removed in the
# same RUN, so no layer contains it. TLS verification is never disabled.
# bookworm, not the default trixie tag: the .so ships in python:3.10-slim-bookworm (glibc 2.36), and a
# trixie build needs GLIBC_2.38.
FROM gcc:15-bookworm@sha256:9ca91b05c7b07d2979f16413e8b2cd6ec8a7c80ffca4121ccab0aeba33f90460

# Upstream Misc/Dockerfile package set, with Debian's blosc in place of an
# unpinned git clone of c-blosc, plus Ninja.
RUN \
    --mount=type=secret,id=extra_ca,required=false \
    set -eu; \
    CAFILE=/etc/ssl/certs/ca-certificates.crt; \
    if [ -s /run/secrets/extra_ca ]; then \
      cat "$CAFILE" /run/secrets/extra_ca > /tmp/ca-bundle.crt; \
      CAFILE=/tmp/ca-bundle.crt; \
      export SSL_CERT_FILE="$CAFILE" GIT_SSL_CAINFO="$CAFILE" CURL_CA_BUNDLE="$CAFILE"; \
    fi; \
    apt-get -o Acquire::https::CaInfo="$CAFILE" update \
 && apt-get -o Acquire::https::CaInfo="$CAFILE" install -y --no-install-recommends \
      cmake ninja-build git pkg-config python3 \
      libboost-iostreams-dev libboost-dev libtbb-dev libblosc-dev \
      zlib1g-dev libzstd-dev liblz4-dev \
      libwayland-dev libxkbcommon-dev wayland-protocols extra-cmake-modules \
      xorg-dev mesa-common-dev libgl1-mesa-dev \
    && mkdir -p /picogk \
    && dpkg-query -W -f '{"package":"${Package}","version":"${Version}"}\n' | sed '$!s/$/,/' | { echo '['; cat; echo ']'; } > /picogk/apt-packages.json \
    && rm -f /tmp/ca-bundle.crt && rm -rf /var/lib/apt/lists/*

ARG PICOGK_RUNTIME_SHA=0f26321c18ed878a7820ef769c38fd5d49d39242

WORKDIR /src
RUN \
    --mount=type=secret,id=extra_ca,required=false \
    set -eu; \
    CAFILE=/etc/ssl/certs/ca-certificates.crt; \
    if [ -s /run/secrets/extra_ca ]; then \
      cat "$CAFILE" /run/secrets/extra_ca > /tmp/ca-bundle.crt; \
      CAFILE=/tmp/ca-bundle.crt; \
      export SSL_CERT_FILE="$CAFILE" GIT_SSL_CAINFO="$CAFILE" CURL_CA_BUNDLE="$CAFILE"; \
    fi; \
    git clone https://github.com/leap71/PicoGKRuntime . \
 && git checkout "$PICOGK_RUNTIME_SHA" \
 && git submodule update --init --recursive --depth 1 \
 && git submodule status --recursive | tee /submodules.txt \
 && rm -f /tmp/ca-bundle.crt

# Same one-line change as upstream PR #30: emit picogk.26.2.so, the name the
# C# library imports, with a matching SONAME. Fail if the line has moved.
RUN grep -q '^if( WIN32 )$' CMakeLists.txt \
 && sed -i '0,/^if( WIN32 )$/s//if( WIN32 OR (UNIX AND NOT APPLE) )/' CMakeLists.txt \
 && git diff --stat

# Only the library target: skips APITests and everything EXCLUDE_FROM_ALL.
# 6 jobs crashed the Docker engine with Docker Desktop's default 8 GB VM.
# CI passes the runner core count.
ARG BUILD_JOBS=3
RUN cmake -S . -B Build -G Ninja -DCMAKE_BUILD_TYPE=Release \
 && cmake --build Build --target picogk.26.2 -j "$BUILD_JOBS" \
 && cp Build/lib/picogk.26.2.so /picogk/ \
 && cp /submodules.txt /picogk/submodules.txt \
 && sha256sum /picogk/picogk.26.2.so | tee /picogk/picogk.26.2.so.sha256 \
 && ldd /picogk/picogk.26.2.so | tee /picogk/ldd.txt \
 && ! grep -q 'not found' /picogk/ldd.txt
