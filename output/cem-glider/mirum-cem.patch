new file mode 100644
index 0000000..9e12c79
--- /dev/null
+++ b/backend/cem/glider/calibration.py
@@ -0,0 +1,77 @@
+"""Immutable content-addressed calibration snapshots and identifiable updates."""
+import copy
+import json
+import math
+import os
+from pathlib import Path
+import re
+
+from cem.core import canonical_json, digest
+
+DEFAULT = Path(__file__).parents[1] / 'calibration/glider.json'
+
+
+def initial():
+    return json.loads(DEFAULT.read_text())
+
+
+def version(calibration):
+    return digest(calibration)
+
+
+def root():
+    return Path(os.environ.get('MIRUM_WORK_DIR', '/tmp/mirum/work')) / 'cem/calibration'
+
+
+def load(identifier=None):
+    base = initial()
+    if identifier in (None, version(base)):
+        return base
+    if not re.fullmatch(r'[0-9a-f]{64}', identifier):
+        raise ValueError('Invalid calibration version')
+    path = root() / f'{identifier}.json'
+    if path.stat().st_size > 65536:
+        raise ValueError('Calibration evidence exceeds budget')
+    value = json.loads(path.read_text())
+    if version(value) != identifier:
+        raise ValueError('Calibration content does not match its version')
+    return value
+
+
+def update_drag(calibration, observed_ratios):
+    """Log-normal update of identifiable *profile* drag observations only.
+
+    Each ratio comes from a fully specified flight condition with known measured
+    launch height. Launch efficiency, mass, CLmax and e are NOT simultaneously
+    fitted from duration/range: those coefficients are not identifiable there.
+    """
+    if not observed_ratios or len(observed_ratios) > 200:
+        raise ValueError('A bounded set of observations is required')
+    if any(not math.isfinite(x) or not .25 <= x <= 4 for x in observed_ratios):
+        raise ValueError('Observation outside supported calibration envelope')
+    updated = copy.deepcopy(calibration)
+    p = calibration['cd0_factor']
+    prior_precision = 1 / p['log_sigma'] ** 2
+    noise_sigma = .10
+    precision = prior_precision + len(observed_ratios) / noise_sigma**2
+    mean = (math.log(p['median']) * prior_precision +
+            sum(math.log(x) for x in observed_ratios) / noise_sigma**2) / precision
+    updated['cd0_factor'] = dict(median=math.exp(mean), log_sigma=math.sqrt(1 / precision))
+    updated.update(version='flight-posterior-1', parent=version(calibration),
+                   state='flight_updated_screening_model', observation_count=len(observed_ratios))
+    return updated
+
+
+def save(calibration):
+    identifier = version(calibration)
+    root().mkdir(parents=True, exist_ok=True)
+    path = root() / f'{identifier}.json'
+    # Content-addressed immutable writes; concurrent updates produce distinct
+    # versions and cannot silently overwrite each other's "latest" calibration.
+    try:
+        with path.open('x') as f:
+            f.write(canonical_json(calibration))
+    except FileExistsError:
+        if load(identifier) != calibration:
+            raise ValueError('Calibration collision')
+    return identifier
diff --git a/backend/cem/glider/closure.py b/backend/cem/glider/closure.py
new file mode 100644
index 0000000..001a2b7
--- /dev/null
+++ b/backend/cem/glider/closure.py
@@ -0,0 +1,98 @@
+"""Independent mesh import, mass/inertia re-prediction and immutable-placement trim."""
+import copy
+import math
+from pathlib import Path
+
+import numpy as np
+
+from gliders.model.assembly import Glider
+from .geometry import measure_part
+from .model import SizedGlider, evaluate_candidate
+
+
+class MeasuredGlider(SizedGlider):
+    def balance(self, x_cg_target):
+        # Geometry, payload and ballast are fixed for the closure solve. The
+        # solver must not rebalance an unbuilt candidate and call it measured.
+        pass
+
+    def mass_summary(self, include_ballast=True, include_payload=True):
+        parts = self.measured_parts
+        masses = [p['mass_kg'] for p in parts]
+        centers = [np.asarray(p['cg_m']) for p in parts]
+        inertias = [np.asarray(p['inertia_kg_m2']) for p in parts]
+        by_part = {p['name']: p['mass_kg'] for p in parts}
+        base = Glider.mass_items(self, include_ballast, include_payload)
+        for item in base:
+            if item.name in ('payload', 'ballast', 'hardware'):
+                masses.append(item.mass)
+                centers.append(np.array([item.x, item.y, item.z]))
+                inertias.append(np.zeros((3, 3)))
+                by_part[item.name] = by_part.get(item.name, 0.) + item.mass
+        mass = sum(masses)
+        cg = sum(m * c for m, c in zip(masses, centers)) / mass
+        inertia = np.zeros((3, 3))
+        for m, c, moment in zip(masses, centers, inertias):
+            displacement = c - cg
+            inertia += moment + m * (np.dot(displacement, displacement) * np.eye(3) - np.outer(displacement, displacement))
+        return dict(mass=mass, cg=cg, Ixx=inertia[0, 0], Iyy=inertia[1, 1], Izz=inertia[2, 2], by_part=by_part)
+
+
+def verify(gl, sized_result, bundle, directory, request, mission, calibration, process):
+    failures, parts = [], []
+    try:
+        for item in bundle['parts']:
+            # All paths originate from the trusted builder, still enforce local
+            # containment and exact revision binding before reading any bytes.
+            path = (directory / item['file']).resolve()
+            if not path.is_relative_to(directory.resolve()):
+                raise ValueError('Artifact path outside bundle')
+            measured = measure_part(path, item['material'])
+            if measured['sha256'] != item['sha256']:
+                raise ValueError('Mesh changed after construction')
+            parts.append(dict(name=item['name'], **measured))
+        lower = np.min([p['bounds_m'][0] for p in parts], axis=0)
+        upper = np.max([p['bounds_m'][1] for p in parts], axis=0)
+        if upper[0] - lower[0] > mission.constraints.max_length_m + 1e-6 or upper[1] - lower[1] > mission.constraints.max_span_m + 1e-6:
+            failures.append('delivered mesh exceeds the approved dimensional envelope')
+        measured = MeasuredGlider(gl.wing, gl.fuse, gl.tail, copy.deepcopy(gl.cfg),
+            ballast_kg=gl.ballast_kg, tail_incidence_deg=gl.tail_incidence_deg,
+            payload_x=gl.payload_x, wing_x=gl.wing_x)
+        measured.measured_parts = parts
+        nose, end = measured.fuse.pod_range()
+        fraction = (measured.wing_position()[0] - nose) / (end - nose)
+        measured.cfg['ranges']['fuselage']['wing_station_in_pod'] = (fraction, fraction)
+        mass = measured.mass_summary()['mass']
+        delta = abs(mass / sized_result['mass_kg'] - 1)
+        if delta > .05:
+            failures.append('measured skin-equivalent mass differs from sizing by more than 5 percent')
+        result = evaluate_candidate(measured, request, mission, calibration, process)
+        if not result['valid']:
+            failures.append('measured-mass aerodynamic admission failed: ' + result['fail_reasons'])
+        if abs(measured.tail_incidence_deg - gl.tail_incidence_deg) > .05:
+            failures.append('measured-mass trim requires a geometry revision')
+        spar_part = next(p for p in parts if p['name'] == 'spar')
+        bounds = np.array(spar_part['bounds_m'])
+        # Recover the uniform Y-axis rod's actual polygon section moment from
+        # its measured solid inertia. Do not substitute an ideal circular formula
+        # for the delivered tessellation's cross-section.
+        moment = np.array(spar_part['inertia_kg_m2'])
+        density = spar_part['material_law']['density_kg_m3']
+        length = bounds[1, 1] - bounds[0, 1]
+        section_ixx = (moment[1, 1] + moment[0, 0] - moment[2, 2]) / (2 * density * length)
+        if not math.isfinite(section_ixx) or section_ixx <= 0:
+            raise ValueError('Missing measured root section inertia')
+        extreme_z = max(abs(bounds[:, 2] - spar_part['cg_m'][2]))
+        stress = gl.spar()['root_moment_nm'] * extreme_z / section_ixx
+        if stress > gl.spar()['allowable_with_sf_pa'] * (1 + 1e-5):
+            failures.append('measured spar fails launch bending')
+        return dict(state='failed' if failures else 'passed', failures=failures,
+                    mass_relative_error=float(delta), measured_mass_kg=float(mass),
+                    measured_spar_stress_pa=float(stress), parts=parts, reanalysis=result,
+                    measured_spar_root_inertia_m4=float(section_ixx),
+                    delivered_bounds_m=[lower.tolist(), upper.tolist()],
+                    scope='Mesh-measured OML skin-equivalent mass and solid rod; not manufactured-part closure',
+                    manufacturing_ready=False)
+    except (ValueError, KeyError, OSError, StopIteration, TypeError):
+        return dict(state='failed', failures=['Required bounded mesh or closure evidence is unavailable'],
+                    manufacturing_ready=False)
diff --git a/backend/cem/glider/discovery.py b/backend/cem/glider/discovery.py
new file mode 100644
index 0000000..b5d84df
--- /dev/null
+++ b/backend/cem/glider/discovery.py
@@ -0,0 +1,83 @@
+"""Bounded MAP-Elites over the existing qualified layouts and parameter search.
+
+Unsupported families are explicit capabilities, never ordinary conventional
+aircraft relabelled as novel. Independent solver rechecks are not implied.
+"""
+from collections import Counter
+from dataclasses import asdict
+import random
+
+from gliders.search import sample, finite_json
+from gliders.design_spec import preset, placement
+from .model import configuration, as_sized, evaluate_candidate, SUPPORTED_FAMILIES
+from .processes import PROCESSES
+
+ALL_FAMILIES = ['conventional', 't_tail', 'v_tail', 'tailless_swept', 'flying_plank',
+                'canard', 'tandem', 'box', 'blended_body']
+
+
+def cell(result):
+    return (result['tail_kind'], int(result['aspect_ratio'] // 2),
+            int(result['wing_loading_g_dm2'] // 2), int(result.get('sweep_qc_deg', 0) // 3))
+
+
+def discover(req, calibration, progress=lambda value: None):
+    processes = list(PROCESSES) if req.process == 'auto' else [req.process]
+    per_process, candidates, records = {}, [], []
+    for process in processes:
+        request, cfg = configuration(req, calibration, process)
+        rng = random.Random(req.discovery.seed)
+        archive, rejected, baseline = {}, Counter(), None
+        for i in range(req.discovery.budget_evals):
+            # A reproducible conventional comparator is always evaluated within
+            # budget. Random/local resampling remains the existing Mirum search.
+            if i == 0:
+                gl = preset(request).build()
+                gl.cfg = cfg
+                # A buildable, larger-chord comparator reduces low-Re artefacts
+                # without relaxing any admission threshold. These remain ordinary
+                # search candidates, never presumed feasible or a bound on optimum.
+                gl.wing.root_chord, gl.wing.taper = .18, .75
+                gl.wing.span = min(1.25, req.constraints.max_span_m)
+                if gl.tail.kind != 'V':
+                    gl.tail.h_root_chord, gl.tail.h_span = .10, .30
+                    gl.tail.v_root_chord, gl.tail.v_height, gl.tail.v_taper = .11, .12, .9
+            else:
+                parent = rng.choice([v[1] for _, v in sorted(archive.items())]) if archive and i % 4 else None
+                gl = sample(rng, cfg, i + 1, parent, radius=max(.05, .25*(1-i/req.discovery.budget_evals)))
+            gl = as_sized(gl)
+            result = evaluate_candidate(gl, request, req, calibration, process)
+            result['sweep_qc_deg'] = gl.wing.sweep_qc_deg
+            if i == 0:
+                baseline = result
+            records.append(dict(process=process, evaluation=i, result=finite_json(result)))
+            if result['valid']:
+                key = cell(result)
+                if key not in archive or result['objective_value'] > archive[key][0]['objective_value']:
+                    archive[key] = (result, gl)
+            else:
+                rejected.update(filter(None, result['fail_reasons'].split('; ')))
+            progress(dict(process=process, evaluated=i+1, budget=req.discovery.budget_evals,
+                          occupied_cells=len(archive)))
+        elites = []
+        for key, (result, gl) in sorted(archive.items()):
+            from cem.core import digest
+            parameters = dict(wing=asdict(gl.wing), fuselage=asdict(gl.fuse), tail=asdict(gl.tail))
+            revision = digest(dict(process=process, parameters=parameters, placement=placement(gl)))[:16]
+            value = finite_json(dict(elite_id=revision, process=process, cell=list(key), result=result,
+                parameters=parameters, placement=placement(gl),
+                verification_state='screened_existing_layout', novelty_state='not_claimed',
+                independent_recheck=dict(state='not_evaluated', missing=['XFOIL station polars', 'AVL trim and modes'])))
+            elites.append(value)
+        elites.sort(key=lambda x: (-x['result']['objective_value'], x['elite_id']))
+        per_process[process] = dict(best=elites[0] if elites else None, archive=elites,
+            rejections=dict(sorted(rejected.items())), baseline=finite_json(baseline),
+            reason_if_no_elite=None if elites else 'No design met the declared physics/model/process envelope')
+        candidates.extend(elites[:req.discovery.top_k])
+    selected = ALL_FAMILIES if req.discovery.families == 'all' else req.discovery.families
+    return dict(status='completed', per_process=per_process, candidates=candidates, evaluations=records,
+        search='seeded MAP-Elites over qualified conventional/T/V layouts; local resampling, no Opti refinement',
+        capabilities=dict(supported_families=list(SUPPORTED_FAMILIES),
+            unavailable_families=[f for f in selected if f not in SUPPORTED_FAMILIES],
+            novel_shape_discovery=False, picogk_builder=False,
+            advanced_environments=False, physical_calibration=calibration['state']))
diff --git a/backend/cem/glider/feasibility.py b/backend/cem/glider/feasibility.py
new file mode 100644
index 0000000..bad6af7
--- /dev/null
+++ b/backend/cem/glider/feasibility.py
@@ -0,0 +1,69 @@
+"""Sub-second optimistic mission screen. A reference failure never stops search."""
+import json
+import math
+from pathlib import Path
+
+from .physics import atmosphere, launch_state, trajectory, G
+from .processes import PROCESSES
+
+
+def feasibility(req, calibration):
+    table = json.loads((Path(__file__).parents[1] / 'data/airfoil_bounds.json').read_text())
+    launch, air = launch_state(req.launch, calibration), atmosphere(req.environment)
+    processes = list(PROCESSES) if req.process == 'auto' else [req.process]
+    # Use the largest table bounds, not a guessed operating Re; no false rejection
+    # caused by selecting a pessimistic Reynolds bin before sizing.
+    ld = max(r['ld_upper'] for r in table['rows'])
+    efficiency = max(r['cl_1_5_over_cd_upper'] for r in table['rows'])
+    payload = req.constraints.payload.mass_kg if req.constraints.payload else 0.
+    # Maximum possible area within the existing chord/span envelope. Omitting
+    # spar, tail and pod is intentional for an optimistic loading lower bound.
+    max_area = req.constraints.max_span_m * .22
+    areal_min = min(PROCESSES[p]['wing_areal_density_kg_m2'] for p in processes)
+    loading = G * (areal_min + (payload + .010) / max_area)
+    sink = math.sqrt(2 * loading / air['density_kg_m3']) / efficiency
+    height = launch['effective_height_m']
+    env = req.environment
+    target = req.reference_target
+    required_ld = target / height if target and height > 0 and req.objective == 'distance_m' else None
+    required_sink = height / target if target and req.objective == 'duration_s' else None
+    bound = height * ld if req.objective == 'distance_m' else height / sink
+    qualified = env.kind == 'still_air'
+    calibration_matches = (all(calibration[k]['median'] == 1. for k in ('cd0_factor', 'cl_max_factor', 'oswald_factor'))
+                           and all(calibration['mass_factor'][p]['median'] == 1. for p in processes))
+    qualified = qualified and calibration_matches
+    if not qualified:
+        # Environment-dependent speed/lift coverage belongs to sizing. A finite
+        # still-air bound must never reject sustained lift or wind missions.
+        bound = None
+    verdict = 'marginal'
+    if target and qualified:
+        verdict = 'infeasible' if target > bound else 'marginal' if target > .8 * bound else 'feasible'
+    needed_height = (target / ld if req.objective == 'distance_m' else target * sink) if target else None
+    if not calibration_matches:
+        needed_height = None
+    levers = [dict(change='relax_reference_target', value=bound, unit=req.objective),
+              dict(change='effective_launch_height', value=needed_height, unit='m')]
+    if target and calibration_matches:
+        # Distance uplift bound assumes V_horizontal = optimistic L/D * sink.
+        desired_time = target / (ld * sink) if req.objective == 'distance_m' else target
+        levers.append(dict(change='mean_uplift', value=max(0., sink - height / desired_time), unit='m/s'))
+        levers.append(dict(change='wing_loading_for_duration', value=(height / desired_time * efficiency)**2 *
+                          air['density_kg_m3'] / 2, unit='N/m2'))
+    return dict(verdict=verdict, verdict_scope='sampled_model_envelope', continue_search=True,
+                objective=req.objective, reference_target=target, optimistic_bound=bound,
+                reference_gap=max(0., target - bound) if target and bound is not None else None,
+                required_lift_to_drag=required_ld, required_sink_m_s=required_sink,
+                optimistic_lift_to_drag=ld if calibration_matches else None,
+                optimistic_cl_1_5_over_cd=efficiency if calibration_matches else None,
+                optimistic_sink_m_s=sink if calibration_matches else None,
+                wing_loading_lower_bound_n_m2=loading if calibration_matches else None,
+                bound_state='sampled_initial_model' if calibration_matches else 'rebuild_required_for_calibration',
+                binding_constraint='aerodynamic efficiency / launch energy' if verdict == 'infeasible' else
+                                   'requires physics sizing; feasibility is not design acceptance',
+                launch=launch, atmosphere=air, levers=levers,
+                bounds_version=table['version'], bounds_source=table['source'],
+                assumptions=launch['assumptions'] + ['Optimistic maximum area; tail, spar and pod mass omitted.',
+                    'Finite-wing envelope assumes AR=14, e=1, profile drag divided by 1.25; body/tail drag omitted.',
+                    'Infeasible means outside this sampled-model envelope, not a universal physical proof.',
+                    'NeuralFoil envelope lacks independent XFOIL cross-validation and physical calibration.'])
diff --git a/backend/cem/glider/geometry.py b/backend/cem/glider/geometry.py
new file mode 100644
index 0000000..cace29f
--- /dev/null
+++ b/backend/cem/glider/geometry.py
@@ -0,0 +1,154 @@
+"""Bounded closed OML meshes, with measured skin-equivalent mass properties.
+
+These are analysis/template bundles. They are not hollow FDM parts and must not
+be advertised as print-ready. Skin-equivalent mass is explicitly an areal law,
+not material density times the volume of a solid outer mould line.
+"""
+from pathlib import Path
+import hashlib
+import math
+import struct
+
+import numpy as np
+
+MAX_FACETS = 100000
+MAX_BYTES = 84 + 50 * MAX_FACETS
+
+
+def closed_mesh(rings):
+    import trimesh
+    vertices = np.vstack(rings)
+    n = len(rings[0])
+    faces = []
+    for j in range(len(rings) - 1):
+        for i in range(n):
+            a, b, c, d = j*n+i, j*n+(i+1)%n, (j+1)*n+i, (j+1)*n+(i+1)%n
+            faces.extend([(a, b, c), (b, d, c)])
+    # NACA sections and fuselage ellipse rings are star-shaped about their
+    # centroids. Explicit end caps belong to construction, never verifier repair.
+    for j, flip in [(0, True), (len(rings)-1, False)]:
+        center = len(vertices)
+        vertices = np.vstack([vertices, np.mean(rings[j], axis=0)])
+        for i in range(n):
+            face = (center, j*n+i, j*n+(i+1)%n)
+            faces.append(face[::-1] if flip else face)
+    mesh = trimesh.Trimesh(vertices=vertices, faces=faces, process=True)
+    mesh.update_faces(mesh.nondegenerate_faces())
+    mesh.remove_unreferenced_vertices()
+    trimesh.repair.fix_normals(mesh, multibody=True)
+    return mesh
+
+
+def surface_meshes(surface):
+    from gliders.model.components import naca
+    # No duplicated closure point; finite NACA trailing edge is closed by a facet.
+    af = naca(surface.airfoil).repanel(n_points_per_side=33).coordinates
+    if np.linalg.norm(af[0] - af[-1]) < 1e-10:
+        af = af[:-1]
+    sections = surface.sections
+    rings = []
+    for j, s in enumerate(sections):
+        neighbor = sections[min(j+1, len(sections)-1)] if j < len(sections)-1 else sections[j-1]
+        direction = np.array([0., neighbor.y - s.y, neighbor.z - s.z])
+        if j == len(sections)-1:
+            direction *= -1
+        direction /= np.linalg.norm(direction)
+        normal = np.cross(np.array([1., 0., 0.]), direction)
+        t = math.radians(s.twist)
+        chord_axis = np.array([math.cos(t), 0., -math.sin(t)])
+        thickness_axis = normal * math.cos(t) + np.array([math.sin(t), 0., 0.])
+        rings.append(np.array([s.x, s.y, s.z]) + s.chord *
+                     (af[:, :1] * chord_axis + af[:, 1:] * thickness_axis))
+    meshes = [closed_mesh(rings)]
+    if surface.symmetric:
+        mirrored = meshes[0].copy()
+        mirrored.apply_scale([1., -1., 1.])
+        meshes.append(mirrored)
+    return meshes
+
+
+def build_meshes(gl):
+    import trimesh
+    parts = []
+    for surface in [gl.wing_surface(), *gl.tail_surfaces()]:
+        for side, mesh in enumerate(surface_meshes(surface)):
+            density = (gl.cfg['materials']['wing_areal_density_kg_m2'] if surface.role == 'wing'
+                       else gl.cfg['materials']['tail_areal_density_kg_m2']) / 2
+            parts.append((f'{surface.name}_{side}', mesh, dict(law='skin_equivalent', areal_density_kg_m2=density)))
+    # Match the existing fuselage cross-section model rather than replacing it
+    # with a visually similar ellipse.
+    ap = gl.fuse.to_asb()
+    rings = []
+    for xs in ap.xsecs:
+        # AeroSandbox's superellipse mesh uses its own cross-section definition.
+        y, z = xs.get_3D_coordinates(theta=np.linspace(0, 2*np.pi, 48, endpoint=False))[1:]
+        rings.append(np.column_stack([np.full(48, float(xs.xyz_c[0])), y, z]))
+    mesh = closed_mesh(rings)
+    parts.append(('fuselage', mesh, dict(law='skin_equivalent',
+                 areal_density_kg_m2=gl.cfg['materials']['fuselage_shell_areal_density_kg_m2'])))
+    spar = gl.spar()
+    transform = trimesh.geometry.align_vectors([0, 0, 1], [0, 1, 0])
+    transform[:3, 3] = [gl.wing_position()[0] + .3*gl.wing.root_chord, 0, gl.wing_position()[1]]
+    rod = trimesh.creation.cylinder(radius=spar['diameter_m']/2, height=spar['span_m'], sections=48, transform=transform)
+    parts.append(('spar', rod, dict(law='solid', density_kg_m3=1600.)))
+    return parts
+
+
+def export_bundle(gl, directory, output_id):
+    from gliders.model import export
+    import trimesh
+    directory.mkdir(parents=True, exist_ok=True)
+    manifest = []
+    for name, mesh, material in build_meshes(gl):
+        if len(mesh.faces) > MAX_FACETS or not mesh.is_watertight or not mesh.is_winding_consistent or mesh.volume <= 0:
+            raise ValueError(f'Construction did not produce a closed oriented {name} mesh')
+        path = directory / f'{output_id}_{name}.stl'
+        export.write_stl(str(path), mesh.vertices, mesh.faces)
+        with path.open('r+b') as f:
+            f.write(f'Mirum CEM {output_id}; mm; analysis OML'.encode().ljust(80, b' '))
+        manifest.append(dict(name=name, file=path.name, material=material,
+                             sha256=hashlib.sha256(path.read_bytes()).hexdigest()))
+    export.export_templates(gl, str(directory))
+    for path in list(directory.glob('*.svg')):
+        if path.name.startswith(output_id + '_'):
+            continue
+        path.write_text(path.read_text().replace('<svg', f'<!-- Mirum CEM {output_id}; screening template -->\n<svg', 1))
+        path.rename(directory / f'{output_id}_{path.name}')
+    return dict(output_id=output_id, parts=manifest, manufacturing_ready=False,
+                geometry_kind='closed outer mould lines + solid spar; skin-equivalent analysis',
+                missing_features=['spar channels', 'rib layout', 'ballast/payload cavities', 'FDM shell/infill/bed splitting'])
+
+
+def measure_part(path, material):
+    import trimesh
+    if path.stat().st_size < 84 or path.stat().st_size > MAX_BYTES:
+        raise ValueError('Mesh size outside evidence budget')
+    with path.open('rb') as f:
+        f.read(80)
+        count = struct.unpack('<I', f.read(4))[0]
+    if count > MAX_FACETS or path.stat().st_size != 84 + 50 * count:
+        raise ValueError('Malformed binary STL or facet budget exceeded')
+    mesh = trimesh.load_mesh(path, file_type='stl', process=True)
+    mesh.apply_scale(.001)  # manufacturing STL units are mm
+    if not np.isfinite(mesh.vertices).all() or not mesh.is_watertight or not mesh.is_winding_consistent or mesh.volume <= 0:
+        raise ValueError('Required closed oriented geometry evidence is missing')
+    if material['law'] == 'solid':
+        props = mesh.mass_properties
+        mass = float(props['volume'] * material['density_kg_m3'])
+        cg = np.asarray(props['center_mass'])
+        inertia = np.asarray(props['inertia']) * material['density_kg_m3']
+    else:
+        triangles = mesh.triangles
+        masses = mesh.area_faces * material['areal_density_kg_m2']
+        mass = float(masses.sum())
+        cg = np.sum(masses[:, None] * triangles.mean(axis=1), axis=0) / mass
+        centered = triangles - cg
+        total = centered.sum(axis=1)
+        moments = (np.einsum('nki,nkj->nij', centered, centered) + np.einsum('ni,nj->nij', total, total)) / 12
+        inertia = np.sum(masses[:, None, None] * (np.trace(moments, axis1=1, axis2=2)[:, None, None] * np.eye(3) - moments), axis=0)
+    if not math.isfinite(mass) or mass <= 0 or not np.isfinite(inertia).all() or np.min(np.linalg.eigvalsh(inertia)) <= 0:
+        raise ValueError('Nonphysical measured mass properties')
+    return dict(mass_kg=mass, cg_m=cg.tolist(), inertia_kg_m2=inertia.tolist(),
+                volume_m3=float(mesh.volume), area_m2=float(mesh.area),
+                bounds_m=mesh.bounds.tolist(), material_law=material,
+                sha256=hashlib.sha256(path.read_bytes()).hexdigest())
